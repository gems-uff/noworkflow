{
  "name": "@noworkflow/trial",
  "version": "0.0.8",
  "description": "noWorkflow - Trial Graph",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*.d.ts",
    "lib/*.js",
    "style/*.css"
  ],
  "directories": {
    "lib": "lib/",
    "style": "style/"
  },
  "dependencies": {
    "@noworkflow/utils": "0.0.9",
    "d3": "^7.9.0",
    "file-saver": "^2.0.5"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/file-saver": "^2.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "eslint": "npm run eslint:check -- --fix",
    "eslint:check": "eslint . --cache",
    "lint": "npm run stylelint && npm run prettier && npm run eslint",
    "lint:check": "npm run stylelint:check && npm run prettier:check && npm run eslint:check",
    "prettier": "npm run prettier:base -- --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
    "prettier:check": "npm run prettier:base -- --check",
    "stylelint": "npm run stylelint:check -- --fix",
    "stylelint:check": "stylelint --cache \"style/**/*.css\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gems-uff/noworkflow.git"
  },
  "author": "Joao Felipe Pimentel <joaofelipenp@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gems-uff/noworkflow/issues"
  },
  "homepage": "http://gems-uff.github.io/noworkflow",
  "outputs": [
    "lib"
  ]
}
